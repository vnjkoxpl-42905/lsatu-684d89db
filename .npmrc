# Always install devDependencies, even if NODE_ENV=production leaks into the shell.
# A global NODE_ENV=production was causing `npm install` to silently prune
# vite/vitest/eslint from node_modules. This forces dev deps to install regardless.
include=dev

# @lovable.dev/email-js optionally peers @react-email/render>=1, but the edge
# email templates pin @react-email/components@0.0.22 (render 0.0.x). Skip strict
# peer resolution so the shared email helper can be deno-checked from the root.
legacy-peer-deps=true
