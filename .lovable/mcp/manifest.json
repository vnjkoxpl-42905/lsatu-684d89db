                    "difficulty": {
                      "type": "string",
                      "enum": [
                        "beginner",
                        "medium",
                        "advanced"
                      ]
                    },
                    "unitId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "area": {
                      "type": "string",
                      "enum": [
                        "understanding",
                        "translation",
                        "linking",
                        "inference",
                        "complex",
                        "application",
                        "quantifiers"
