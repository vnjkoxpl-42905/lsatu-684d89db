          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "student_id": {
              "type": "string",
              "format": "uuid",
              "description": "Exact student ID from find_students or list_students."
            },
            "item": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "prep_test_section"
                    },
                    "prep_test": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "description": "PrepTest number, for example 150."
