                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "drill_level": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "beginner",
                        "intermediate",
                        "advanced"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Defaults to the student profile level. Explicit null uses the drill's own range."
                },
                "question_count": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 2147483647,
