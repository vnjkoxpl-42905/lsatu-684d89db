                    "section_type": {
                      "type": "string",
                      "enum": [
                        "LR",
                        "RC"
                      ]
                    },
                    "section_number": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "any_section": {
                      "type": "boolean",
                      "description": "Set true only when the teacher explicitly accepts any section of the specified type."
                    }
                  },
                  "required": [
                    "kind",
                    "prep_test"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
