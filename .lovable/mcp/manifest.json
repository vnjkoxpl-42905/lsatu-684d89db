                        3
                      ]
                    },
                    "courseEdition": {
                      "type": "string",
                      "const": "full-conditionals-v3"
                    },
                    "activityId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "activitySettings": {
                      "type": "object",
                      "additionalProperties": {
