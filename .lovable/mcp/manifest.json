                        "course",
                        "stage",
                        "area",
                        "skill",
                        "general",
                        "activity"
                      ]
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "learn",
                        "practice"
                      ]
                    },
                    "difficulty": {
                      "type": "string",
                      "enum": [
                        "beginner",
                        "medium",
                        "advanced"
                      ]
                    },
                    "unitId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
