                  },
                  "required": [
                    "kind",
                    "query"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "bootcamp"
                    },
                    "query": {
                      "$ref": "#/properties/item/anyOf/1/properties/query"
                    }
                  },
                  "required": [
                    "kind",
                    "query"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "settings": {
              "type": "object",
              "properties": {
                "scheduled_for": {
                  "type": "string",
                  "format": "date",
                  "description": "Calendar date in time_zone. Unlocks at local midnight."
                },
                "due_on": {
                  "type": "string",
                  "format": "date",
                  "description": "Calendar date in time_zone. Due at the end of that day."
                },
                "time_zone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "IANA time zone, such as America/Toronto. Required when specifying a date."
                },
                "notify": {
                  "type": "boolean",
                  "description": "Defaults to true. Future work sends only its scheduled in-app bell."
                },
                "allow_repeat": {
                  "type": "boolean",
                  "description": "Explicitly assign a second copy of a guided drill or activity, while still showing existing copies in preview."
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
