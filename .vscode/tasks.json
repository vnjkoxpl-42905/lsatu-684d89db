{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "detail": "Vite dev server on port 8080",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "cockpit" },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "build",
      "detail": "Production build (vite build)",
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "lint",
      "detail": "ESLint over the whole repo (will fail on pre-existing debt)",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "lint:changed",
      "detail": "ESLint only on files changed vs origin/main + working tree",
      "type": "shell",
      "command": "bash scripts/lint-changed.sh",
      "problemMatcher": ["$eslint-stylish"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "typecheck",
      "detail": "tsc --noEmit (no typecheck npm script exists)",
      "type": "shell",
      "command": "npx tsc --noEmit -p tsconfig.app.json",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "test",
      "detail": "Vitest single run (37 specs)",
      "type": "npm",
      "script": "test",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "playwright",
      "detail": "Playwright e2e (no app specs yet; config is the Lovable wrapper)",
      "type": "shell",
      "command": "npx playwright test",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "verify-current-lane",
      "detail": "lint:changed -> typecheck -> build -> test, in sequence (lint scoped to your changes, not legacy debt)",
      "dependsOrder": "sequence",
      "dependsOn": ["lint:changed", "typecheck", "build", "test"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
