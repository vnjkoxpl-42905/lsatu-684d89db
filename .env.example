# Google Drive Picker (admin-only feature at /admin/drive-files)
VITE_GOOGLE_CLIENT_ID=placeholder
VITE_GOOGLE_API_KEY=placeholder
VITE_TURNSTILE_SITE_KEY=placeholder

# Set to 1 to walk feature-gated routes locally without the matching access
# flags. Leave unset so a plain `npm run dev` exercises the real permission
# path and a gating regression is caught before it deploys. Dev + localhost only.
# VITE_DEV_BYPASS_GATES=1
