{
  "topic": "abstract",
  "cards": [
    {
      "id": "fc-abstract-001",
      "front": "Presuppose",
      "back": "Means **require**. A necessary condition. If the presupposed thing weren't true, the argument would collapse.",
      "example": "'The argument presupposes the witness is reliable' means 'the argument requires that the witness be reliable.'",
      "concept_tag": "glossary",
      "difficulty_tag": "foundation",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-002",
      "front": "Explanation",
      "back": "Means **cause**. The cause that produced the effect. Not 'elaborating' or 'clarifying.'",
      "example": "'A phenomenon for which the conclusion is offered as an explanation' means an effect the conclusion proposes a cause for.",
      "concept_tag": "glossary",
      "difficulty_tag": "foundation",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-003",
      "front": "Hypothesis",
      "back": "Means **potential cause**. A causal guess. Not a prediction. Not a theory in the loose sense.",
      "example": "Darwin's hypothesis: species change over generations, which would explain why birds have features adapted to their environment.",
      "concept_tag": "glossary",
      "difficulty_tag": "foundation",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-004",
      "front": "FABS",
      "back": "**F**or, **A**s, **B**ecause, **S**ince. The four support indicators. Anything after one of these points backward to evidence.",
      "concept_tag": "indicator",
      "difficulty_tag": "foundation",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-005",
      "front": "Slot 1: Background",
      "back": "Neutral facts setting the scene. Not the argument, just the world the argument lives in.",
      "concept_tag": "glossary",
      "difficulty_tag": "foundation",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-006",
      "front": "Slot 2: Opposing Conclusion",
      "back": "What someone *else* thinks. The view the author pushes back against.",
      "concept_tag": "glossary",
      "difficulty_tag": "foundation",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-007",
      "front": "Slot 3: Opposing Evidence",
      "back": "Why the opposing view thinks they're right. Supports the opposing conclusion, not the author's.",
      "concept_tag": "glossary",
      "difficulty_tag": "foundation",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-008",
      "front": "Slot 4: Concession",
      "back": "Something the author admits is true even though it could be used against them. Tell: granted, while, although, naturally, though it is true.",
      "concept_tag": "glossary",
      "difficulty_tag": "foundation",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-009",
      "front": "Slot 5: Author's Conclusion",
      "back": "What the author actually thinks. The main point. Only supported, never supports.",
      "concept_tag": "glossary",
      "difficulty_tag": "foundation",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-010",
      "front": "Slot 6: Intermediate Conclusion",
      "back": "A sub-claim the author proves on the way to the main conclusion. Both supported by, and supporting, other claims.",
      "concept_tag": "glossary",
      "difficulty_tag": "foundation",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-011",
      "front": "Slot 7: Author's Evidence",
      "back": "The reasons the author gives. Supports the conclusion, not supported by anything inside the argument.",
      "concept_tag": "glossary",
      "difficulty_tag": "foundation",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-012",
      "front": "Inference",
      "back": "A claim that must be true given the statements. Provable, not necessarily important.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-013",
      "front": "Imply / Suggest",
      "back": "Indicate or hint at, but weaker than entail.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-014",
      "front": "Entail",
      "back": "Logically guarantee.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-015",
      "front": "Assume / Take for granted",
      "back": "Rely on without proof.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-016",
      "front": "Phenomenon",
      "back": "Something that happened that needs explaining. The effect side of a cause-effect pair.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-017",
      "front": "Illustrate",
      "back": "Give an example of.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-018",
      "front": "Analogy",
      "back": "A different specific case that's similar in some general way.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-019",
      "front": "Example",
      "back": "A specific case that illustrates a general idea.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-020",
      "front": "Counterexample",
      "back": "A specific case that goes against a general claim.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-021",
      "front": "Alternate Explanation",
      "back": "A different proposed cause for the same effect.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-022",
      "front": "General Principle",
      "back": "A rule that applies to multiple scenarios. Not just one case.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-023",
      "front": "Generalization",
      "back": "A summary statement derived from cases. Describes what *is*.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-024",
      "front": "Principle",
      "back": "A guiding rule. Prescribes what *should* be.",
      "concept_tag": "glossary",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-025",
      "front": "Aesthetic Principle",
      "back": "A broad normative rule, not a one-off judgment.",
      "concept_tag": "glossary",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-026",
      "front": "Defend",
      "back": "Justify as right or correct. Not just stating a motive.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-027",
      "front": "Substantiate",
      "back": "Support with evidence.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-028",
      "front": "Corroborate",
      "back": "Confirm or back up.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-029",
      "front": "Establish",
      "back": "Prove. Stronger than support.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-030",
      "front": "Undermine",
      "back": "Weaken. Attack the support.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-031",
      "front": "Refute",
      "back": "Prove false. Stronger than undermine.",
      "concept_tag": "glossary",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-032",
      "front": "Concede",
      "back": "Admit something potentially against your own position.",
      "concept_tag": "glossary",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-033",
      "front": "Maintain / Hold / Contend / Assert",
      "back": "Claim or argue. Often the verb attached to an opposing view.",
      "concept_tag": "glossary",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-034",
      "front": "Posit",
      "back": "Propose, usually a cause.",
      "concept_tag": "glossary",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-035",
      "front": "Account For",
      "back": "Explain. Causal sense.",
      "concept_tag": "glossary",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-036",
      "front": "Supported Premise",
      "back": "An intermediate conclusion. Functions as both a premise and a sub-conclusion.",
      "concept_tag": "glossary",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-037",
      "front": "Hence",
      "back": "**Conclusion indicator.** A conclusion follows.",
      "concept_tag": "indicator",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-038",
      "front": "Therefore",
      "back": "**Conclusion indicator.** A conclusion follows.",
      "concept_tag": "indicator",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-039",
      "front": "Thus",
      "back": "**Conclusion indicator.** A conclusion follows.",
      "concept_tag": "indicator",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-040",
      "front": "Consequently",
      "back": "**Conclusion indicator.** A conclusion follows.",
      "concept_tag": "indicator",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-041",
      "front": "It follows that",
      "back": "**Conclusion indicator.** A conclusion follows.",
      "concept_tag": "indicator",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-042",
      "front": "Because",
      "back": "**Support indicator (FABS).** Whatever follows is evidence for the prior claim.",
      "concept_tag": "indicator",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-043",
      "front": "Since",
      "back": "**Support indicator (FABS).** Whatever follows is evidence for the prior claim.",
      "concept_tag": "indicator",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-044",
      "front": "For (as a connector)",
      "back": "**Support indicator (FABS).** As in 'we should go, for the weather is improving.' Evidence follows.",
      "concept_tag": "indicator",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-045",
      "front": "However",
      "back": "**Pivot indicator.** Crossing from one viewpoint to another.",
      "concept_tag": "indicator",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-046",
      "front": "But",
      "back": "**Pivot indicator.** Crossing from one viewpoint to another.",
      "concept_tag": "indicator",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-047",
      "front": "Most people think",
      "back": "**Opposing-view indicator.** What follows is what someone else believes, not the author.",
      "concept_tag": "indicator",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-048",
      "front": "Some contend",
      "back": "**Opposing-view indicator.** What follows is the opposing view's claim.",
      "concept_tag": "indicator",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-049",
      "front": "It has been said",
      "back": "**Opposing-view indicator.** Someone else's claim. The author will likely push back.",
      "concept_tag": "indicator",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-050",
      "front": "Although",
      "back": "**Concession indicator.** The author admits what follows, even though it could cut against them.",
      "concept_tag": "indicator",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-051",
      "front": "Granted",
      "back": "**Concession indicator.** The author admits what follows. Not an opposing view.",
      "concept_tag": "indicator",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-052",
      "front": "Concludes / Infers / Reasons / Argues",
      "back": "**Verb taxonomy.** The author has a conclusion. The verb flags it.",
      "concept_tag": "verb-taxonomy",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-053",
      "front": "Presupposes / Assumes / Takes for granted",
      "back": "**Verb taxonomy.** The author depends on something unstated. Necessary-assumption territory.",
      "concept_tag": "verb-taxonomy",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-054",
      "front": "Appeals to / Cites / Uses",
      "back": "**Verb taxonomy.** The author is invoking evidence.",
      "concept_tag": "verb-taxonomy",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-055",
      "front": "Counters / Anticipates / Pre-empts",
      "back": "**Verb taxonomy.** The author shuts down an objection in advance.",
      "concept_tag": "verb-taxonomy",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-056",
      "front": "Denies / Rejects / Challenges",
      "back": "**Verb taxonomy.** The author argues against another claim.",
      "concept_tag": "verb-taxonomy",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-057",
      "front": "Substantiates / Supports",
      "back": "**Verb taxonomy.** Provides evidence for something.",
      "concept_tag": "verb-taxonomy",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-058",
      "front": "Establishes / Demonstrates",
      "back": "**Verb taxonomy.** Stronger than supports. Provides proving-strength evidence.",
      "concept_tag": "verb-taxonomy",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-059",
      "front": "Undermines / Weakens / Calls into question",
      "back": "**Verb taxonomy.** The author attacks another claim.",
      "concept_tag": "verb-taxonomy",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-060",
      "front": "Illustrates",
      "back": "**Verb taxonomy.** The author is giving an example.",
      "concept_tag": "verb-taxonomy",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-061",
      "front": "Derives",
      "back": "**Verb taxonomy.** The author concludes something from a constraint or impossibility.",
      "concept_tag": "verb-taxonomy",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-062",
      "front": "Maintains / Holds / Contends",
      "back": "**Verb taxonomy.** The author has a position. Often introduces an opposing view.",
      "concept_tag": "verb-taxonomy",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-063",
      "front": "Posits",
      "back": "**Verb taxonomy.** The author proposes something, usually a causal account.",
      "concept_tag": "verb-taxonomy",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-064",
      "front": "Anticipates an objection",
      "back": "**Verb taxonomy.** The author flags a possible counter-argument and shuts it down preemptively.",
      "concept_tag": "verb-taxonomy",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-065",
      "front": "Concludes X on the basis of Y",
      "back": "Y is the evidence, X is the conclusion. 'On the basis of' points backward.",
      "concept_tag": "verb-taxonomy",
      "difficulty_tag": "core",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-066",
      "front": "Doing X by doing Y",
      "back": "X is the broader move. Y is the specific tactic. 'By' points backward to the tactic.",
      "concept_tag": "verb-taxonomy",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-067",
      "front": "Decision",
      "back": "A choice. Can be premise or conclusion.",
      "concept_tag": "glossary",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    },
    {
      "id": "fc-abstract-068",
      "front": "Fact",
      "back": "A statement true regardless of viewpoint. Often premise or background.",
      "concept_tag": "glossary",
      "difficulty_tag": "advanced",
      "topic_tag": "abstract"
    }
  ]
}
