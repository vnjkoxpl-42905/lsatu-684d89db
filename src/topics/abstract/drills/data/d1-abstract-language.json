{
  "version": 1,
  "source": "Built fresh for v1.2 content boundary: argument-part labeling moved back to Intro to LR; D1 now teaches the same abstract-to-plain translation move as the rest of the bootcamp.",
  "questions": [
    {
      "id": "d1-q01",
      "phrase": "fails to consider",
      "options": [
        { "id": "a", "text": "explicitly rejects" },
        { "id": "b", "text": "overlooks" },
        { "id": "c", "text": "proves wrong" },
        { "id": "d", "text": "concludes" }
      ],
      "correct": "b",
      "explanation": "\"Fails to consider\" is the LSAT's way of saying the author did not think about something. The plain English is \"overlooks.\""
    },
    {
      "id": "d1-q02",
      "phrase": "takes for granted",
      "options": [
        { "id": "a", "text": "proves" },
        { "id": "b", "text": "denies" },
        { "id": "c", "text": "assumes" },
        { "id": "d", "text": "observes" }
      ],
      "correct": "c",
      "explanation": "\"Takes for granted\" is the LSAT's signature phrasing for an unstated assumption. Plain English: \"assumes.\""
    },
    {
      "id": "d1-q03",
      "phrase": "presupposes",
      "options": [
        { "id": "a", "text": "requires" },
        { "id": "b", "text": "predicts" },
        { "id": "c", "text": "weakens" },
        { "id": "d", "text": "summarizes" }
      ],
      "correct": "a",
      "explanation": "\"Presupposes X\" means the argument cannot work without X. Plain English: \"requires.\""
    },
    {
      "id": "d1-q04",
      "phrase": "phenomenon",
      "options": [
        { "id": "a", "text": "the author's opinion" },
        { "id": "b", "text": "an observed thing" },
        { "id": "c", "text": "an opposing argument" },
        { "id": "d", "text": "a hypothesis" }
      ],
      "correct": "b",
      "explanation": "A \"phenomenon\" is just something that has been observed. It is the thing the argument is trying to explain, not the explanation itself."
    },
    {
      "id": "d1-q05",
      "phrase": "hypothesis",
      "options": [
        { "id": "a", "text": "a fact already established" },
        { "id": "b", "text": "an irrelevant aside" },
        { "id": "c", "text": "a possible explanation" },
        { "id": "d", "text": "the conclusion of the argument" }
      ],
      "correct": "c",
      "explanation": "A \"hypothesis\" is a candidate explanation offered for the phenomenon. Plain English: \"possible explanation.\""
    },
    {
      "id": "d1-q06",
      "phrase": "undermines",
      "options": [
        { "id": "a", "text": "weakens" },
        { "id": "b", "text": "proves" },
        { "id": "c", "text": "restates" },
        { "id": "d", "text": "ignores" }
      ],
      "correct": "a",
      "explanation": "\"Undermines\" means to chip away at, to make less believable. Plain English: \"weakens.\""
    },
    {
      "id": "d1-q07",
      "phrase": "calls into question",
      "options": [
        { "id": "a", "text": "confirms" },
        { "id": "b", "text": "challenges" },
        { "id": "c", "text": "summarizes" },
        { "id": "d", "text": "describes" }
      ],
      "correct": "b",
      "explanation": "\"Calls into question\" is a softer cousin of undermines. The author is not proving the claim wrong, just challenging it."
    },
    {
      "id": "d1-q08",
      "phrase": "casts doubt on",
      "options": [
        { "id": "a", "text": "weakens" },
        { "id": "b", "text": "concedes" },
        { "id": "c", "text": "predicts" },
        { "id": "d", "text": "concludes" }
      ],
      "correct": "a",
      "explanation": "Same family as undermines. Plain English: \"weakens.\""
    },
    {
      "id": "d1-q09",
      "phrase": "lends support to",
      "options": [
        { "id": "a", "text": "questions" },
        { "id": "b", "text": "supports" },
        { "id": "c", "text": "introduces" },
        { "id": "d", "text": "contradicts" }
      ],
      "correct": "b",
      "explanation": "\"Lends support to X\" is just a longer way of saying \"supports X.\" The verb taxonomy lives on one axis: support, weaken, neutral."
    },
    {
      "id": "d1-q10",
      "phrase": "is consistent with",
      "options": [
        { "id": "a", "text": "proves" },
        { "id": "b", "text": "doesn't conflict with" },
        { "id": "c", "text": "weakens" },
        { "id": "d", "text": "explains" }
      ],
      "correct": "b",
      "explanation": "\"Consistent with\" is a weak relationship. It does not prove the claim and does not weaken it. Plain English: \"doesn't conflict with.\""
    },
    {
      "id": "d1-q11",
      "phrase": "is incompatible with",
      "options": [
        { "id": "a", "text": "supports" },
        { "id": "b", "text": "rules out" },
        { "id": "c", "text": "is irrelevant to" },
        { "id": "d", "text": "weakens slightly" }
      ],
      "correct": "b",
      "explanation": "\"Incompatible with X\" means X cannot be true. It is a strong negative relationship. Plain English: \"rules out.\""
    },
    {
      "id": "d1-q12",
      "phrase": "appeals to",
      "options": [
        { "id": "a", "text": "asks for help from" },
        { "id": "b", "text": "rejects" },
        { "id": "c", "text": "uses as support" },
        { "id": "d", "text": "addresses" }
      ],
      "correct": "c",
      "explanation": "\"The argument appeals to X\" is method-of-reasoning vocabulary. The author is using X as support for the conclusion."
    },
    {
      "id": "d1-q13",
      "phrase": "infers",
      "options": [
        { "id": "a", "text": "implies" },
        { "id": "b", "text": "observes" },
        { "id": "c", "text": "concludes" },
        { "id": "d", "text": "doubts" }
      ],
      "correct": "c",
      "explanation": "\"Infers\" and \"implies\" are not the same word. The author infers a conclusion; the evidence implies the conclusion. Plain English for \"infers\": \"concludes.\""
    },
    {
      "id": "d1-q14",
      "phrase": "establishes",
      "options": [
        { "id": "a", "text": "proves" },
        { "id": "b", "text": "introduces" },
        { "id": "c", "text": "concedes" },
        { "id": "d", "text": "weakens" }
      ],
      "correct": "a",
      "explanation": "\"Establishes X\" is the strongest support verb. It means the argument has proved X. Plain English: \"proves.\""
    }
  ]
}
